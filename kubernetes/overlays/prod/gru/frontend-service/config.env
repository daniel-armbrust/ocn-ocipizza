# =========================================================
# Aplicação - produção
# =========================================================

APP_NAME=frontend-service
APP_ENV=production
DEBUG=false

# =========================================================
# Sessão do cliente - OCI Cache
# =========================================================

PERSISTENCE_PROVIDER=redis
SESSION_COOKIE_NAME=ocpssid
SESSION_TTL=86400
# REDIS_ENDPOINT e as chaves de sessão são obtidos de frontend-service-secrets.

# =========================================================
# Serviços internos da aplicação
# =========================================================

PIZZA_SERVICE_URL=http://pizza-service:8000
USER_SERVICE_URL=http://user-service:8000
DELIVERY_SERVICE_URL=http://delivery-service:8000
ORDER_SERVICE_URL=http://order-service:8000
HTTP_CLIENT_TIMEOUT=10.0
CHATBOT_CLIENT_TIMEOUT=60.0

# =========================================================
# Observabilidade - GRU
# =========================================================

LOG_LEVEL=INFO
OCI_LOG_ID=${FRONTEND_SERVICE_LOG_ID_GRU}
