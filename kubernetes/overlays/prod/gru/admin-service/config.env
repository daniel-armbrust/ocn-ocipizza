# =========================================================
# Aplicação - produção
# =========================================================

APP_NAME=admin-service
APP_ENV=production
DEBUG=false

# =========================================================
# Sessão administrativa - OCI Cache
# =========================================================

PERSISTENCE_PROVIDER=redis
SESSION_COOKIE_NAME=admocpssid
SESSION_TTL=3600
# REDIS_ENDPOINT e as chaves de sessão são obtidos de admin-service-secrets.

# =========================================================
# Serviços internos da aplicação
# =========================================================

PIZZA_SERVICE_URL=http://pizza-service:8000
USER_SERVICE_URL=http://user-service:8000
DELIVERY_SERVICE_URL=http://delivery-service:8000
ORDER_SERVICE_URL=http://order-service:8000
HTTP_CLIENT_TIMEOUT=10.0

# =========================================================
# Validação dos tokens emitidos pelo user-service
# =========================================================

JWT_ISSUER=user-service
JWT_AUDIENCE=ocipizza
JWT_JWKS_URL=http://user-service:8000/.well-known/jwks.json

# =========================================================
# OCI Object Storage
# =========================================================

OBJECTSTORAGE_ENDPOINT=https://objectstorage.sa-saopaulo-1.oraclecloud.com
OBJECTSTORAGE_NAMESPACE=${OCI_NAMESPACE}
PIZZA_IMAGES_OBJECTSTORAGE_BUCKET=pizza-images

# =========================================================
# Observabilidade
# =========================================================

LOG_LEVEL=INFO
OCI_LOG_ID=${ADMIN_SERVICE_LOG_ID_GRU}
