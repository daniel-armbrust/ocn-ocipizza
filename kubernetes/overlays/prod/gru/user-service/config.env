# =========================================================
# Aplicação - produção
# =========================================================

APP_NAME=user-service
APP_ENV=production
DEBUG=false

# =========================================================
# Persistência - MySQL
# =========================================================

PERSISTENCE_PROVIDER=sqlalchemy
# DATABASE_WRITE_URL e DATABASE_READ_URL são obtidas do Secret user-service-secrets.

# =========================================================
# Mensageria - OCI Queue em GRU
# =========================================================

MESSAGING_PROVIDER=oci_queue
QUEUE_NAME=notifications-queue
OCI_QUEUE_ID=${NOTIFICATION_QUEUE_ID_GRU}

# =========================================================
# Assinatura e validação dos tokens JWT
# =========================================================

JWT_KEY_PROVIDER=oci
JWT_PRIVATE_KEY_SECRET_ID=${USER_SERVICE_JWT_PRIVATE_KEY_SECRET_ID_GRU}
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem
JWT_ISSUER=user-service
JWT_AUDIENCE=ocipizza
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# =========================================================
# Autenticação OCI
# =========================================================

OCI_AUTH_MODE=instance_principal

# =========================================================
# Observabilidade - GRU
# =========================================================

LOG_LEVEL=INFO
OCI_LOG_ID=${USER_SERVICE_LOG_ID_GRU}
