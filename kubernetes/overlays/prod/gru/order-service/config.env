# =========================================================
# Aplicação - produção
# =========================================================

APP_NAME=order-service
APP_ENV=production
DEBUG=false

# =========================================================
# Persistência - OCI NoSQL
# =========================================================

PERSISTENCE_PROVIDER=nosql
NOSQL_PROVIDER=oci
NOSQL_TABLE_NAME=orders
NOSQL_COMPARTMENT_ID=${OCI_PIZZA_COMPARTMENT_ID}

# =========================================================
# Mensageria - OCI Queue em GRU
# =========================================================

MESSAGING_PROVIDER=oci_queue
QUEUE_NAME=notifications-queue
OCI_QUEUE_ID=${NOTIFICATION_QUEUE_ID_GRU}

# =========================================================
# Autenticação OCI
# =========================================================

OCI_AUTH_MODE=instance_principal

# =========================================================
# Validação dos tokens emitidos pelo user-service
# =========================================================

JWT_ISSUER=user-service
JWT_AUDIENCE=ocipizza
JWT_JWKS_URL=http://user-service:8000/.well-known/jwks.json
HTTP_CLIENT_TIMEOUT=10.0

# =========================================================
# Observabilidade - GRU
# =========================================================

LOG_LEVEL=INFO
OCI_LOG_ID=${ORDER_SERVICE_LOG_ID_GRU}
