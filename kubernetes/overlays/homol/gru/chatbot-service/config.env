# =========================================================
# Aplicação - homologação
# =========================================================

APP_NAME=chatbot-service
# O código do serviço aceita apenas development ou production.
APP_ENV=production
DEBUG=false

# =========================================================
# Detecção de intenção e geração de respostas
# =========================================================

INTENT_PROVIDER=oci_genai
INTENT_MIN_CONFIDENCE=0.70
RESPONSE_PROVIDER=oci_genai
GENAI_MODEL_ID=${CHATBOT_GENAI_MODEL_ID}

# =========================================================
# Autenticação OCI
# =========================================================

OCI_AUTH_MODE=instance_principal

# =========================================================
# Validação dos tokens emitidos pelo user-service
# =========================================================

JWT_ISSUER=user-service
JWT_AUDIENCE=ocipizza
JWT_JWKS_URL=http://user-service:8000/.well-known/jwks.json
HTTP_CLIENT_TIMEOUT=10.0

# =========================================================
# Observabilidade - GRU
# =========================================================

LOG_LEVEL=INFO
OCI_LOG_ID=${CHATBOT_SERVICE_LOG_ID_GRU}
