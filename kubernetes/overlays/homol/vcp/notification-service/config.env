# =========================================================
# Aplicação - homologação
# =========================================================

APP_NAME=notification-service
# O código do serviço aceita apenas development ou production.
APP_ENV=production
DEBUG=false
SITE_URL=${SITE_URL_HOMOL}

# =========================================================
# Mensageria - OCI Queue em VCP
# =========================================================

MESSAGING_PROVIDER=oci_queue
QUEUE_NAME=notifications-queue
OCI_QUEUE_ID=${NOTIFICATION_QUEUE_ID_VCP}
NOTIFICATION_POLL_INTERVAL=5.0
NOTIFICATION_RETRY_INTERVAL=10.0

# =========================================================
# Envio de e-mails - OCI Email Delivery
# =========================================================

EMAIL_PROVIDER=oci
OCI_EMAIL_DELIVERY_COMPARTMENT_ID=${OCI_PIZZA_COMPARTMENT_ID}
OCI_EMAIL_SENDER_NAME=OCI Pizza
SMTP_EMAIL_SENDER=no-reply@ocipizza.com.br

# =========================================================
# Autenticação OCI
# =========================================================

OCI_AUTH_MODE=instance_principal

# =========================================================
# Observabilidade - VCP
# =========================================================

LOG_LEVEL=INFO
OCI_LOG_ID=${NOTIFICATION_SERVICE_LOG_ID_VCP}
