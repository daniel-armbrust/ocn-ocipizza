#
# order-service/.env.example
#

APP_NAME=order-service
APP_ENV=development
DEBUG=true

# Providers suportados: nosql, sqlalchemy.
PERSISTENCE_PROVIDER=nosql

# Configuração do provider Oracle NoSQL.
NOSQL_TABLE_NAME=orders
NOSQL_ENDPOINT=http://localhost:18080
NOSQL_COMPARTMENT_ID=

# Configuração do provider SQLAlchemy.
# A API ainda não possui um repositório de pedidos SQLAlchemy implementado.
DATABASE_URL=

# Mensageria
# Providers suportados: rabbitmq, oci_queue.
MESSAGING_PROVIDER=rabbitmq
QUEUE_NAME=notifications-queue

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=oci_pizza
RABBITMQ_PASSWORD=oci_pizza

# OCI Queue
# Obrigatórias somente quando MESSAGING_PROVIDER=oci_queue.
OCI_QUEUE_ID=
OCI_QUEUE_MESSAGES_ENDPOINT=

# Configuração dos access tokens emitidos pelo user-service.
JWT_ISSUER=user-service
JWT_AUDIENCE=ocipizza
JWT_JWKS_URL=http://localhost:8002/.well-known/jwks.json

# Timeout das chamadas HTTP ao JWKS, em segundos.
HTTP_CLIENT_TIMEOUT=10.0

# Região utilizada pelo Oracle NoSQL fora de development.
OCI_REGION=sa-saopaulo-1

# Logging. OCI_LOG_ID é obrigatório fora de development.
LOG_LEVEL=INFO
OCI_LOG_ID=
