#
# .env.example
#

APP_NAME=delivery-service
APP_ENV=development
DEBUG=true

OCI_REGION=sa-saopaulo-1
OCI_AUTH_MODE=
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT

# Providers suportados: nosql, sqlalchemy.
PERSISTENCE_PROVIDER=nosql

# Configuração do provider Oracle NoSQL.
NOSQL_TABLE_NAME=delivery_areas
NOSQL_ENDPOINT=http://localhost:18080
NOSQL_COMPARTMENT_ID=

# Configuração do provider SQLAlchemy.
# DATABASE_URL=mysql+pymysql://delivery_service:delivery_service@127.0.0.1:13306/delivery_areas

# Configuração dos access tokens emitidos pelo user-service.
JWT_ISSUER=user-service
JWT_AUDIENCE=ocipizza
JWT_JWKS_URL=http://localhost:8002/.well-known/jwks.json

# OCID do Custom Log utilizado fora de development.
LOG_LEVEL=INFO
OCI_LOG_ID=
