#
# .env.example
#

APP_NAME=frontend-service
APP_ENV=development
DEBUG=true

# Persistência de sessões. Redis é o provider padrão.
PERSISTENCE_PROVIDER=redis
REDIS_ENDPOINT=redis://127.0.0.1:16379/0

# Obrigatória somente quando PERSISTENCE_PROVIDER=sqlalchemy.
DATABASE_URL=

# URLs dos serviços acessados pelo BFF (Backend For Frontend).
PIZZA_SERVICE_URL=http://localhost:8001

USER_SERVICE_URL=http://localhost:8002

DELIVERY_SERVICE_URL=http://localhost:8003

ORDER_SERVICE_URL=http://localhost:8004

# Timeout padrão das chamadas aos microserviços.
HTTP_CLIENT_TIMEOUT=10.0

# Timeout estendido utilizado pelo chatbot-service.
CHATBOT_CLIENT_TIMEOUT=60.0

# Sessão opaca mantida pelo BFF e proteção CSRF.
SESSION_COOKIE_NAME=ocpssid
SESSION_TTL=86400
SESSION_SECRET_KEY="!!!Sup3rS3cr3t0!!!"
CSRF_SECRET_KEY="!!!Sup3rS3cr3t0!!!"

# Logging
LOG_LEVEL=INFO
OCI_LOG_ID=
