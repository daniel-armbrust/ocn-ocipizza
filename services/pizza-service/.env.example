# OCI Pizza - Pizza Service Configuration

# Ambiente da aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO

# Região OCI onde o serviço NoSQL está provisionado
OCI_REGION=sa-saopaulo-1

# Endpoint de autenticação
AUTH_SERVICE_URL=

# Token administrativo local para operações de escrita
PIZZA_SERVICE_ADMIN_TOKEN=admin-token

# OCI NoSQL Database

## Endpoint do Oracle NoSQL Database
OCI_NOSQL_ENDPOINT=http://localhost:18080

## Nome da tabela utilizada pelo serviço
OCI_NOSQL_TABLE=pizzas

## OCID do compartment da tabela em OCI. No ambiente local com endpoint de desenvolvimento pode ficar vazio.
OCI_NOSQL_COMPARTMENT_ID=

## Configuração OCI usada apenas em desenvolvimento/local.
OCI_CONFIG_FILE=/home/appuser/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# OCI Object Storage

## Endpoint local do Object Storage compatível com S3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

## Bucket utilizado para imagens das pizzas
OBJECT_STORAGE_BUCKET=pizza-images

## Credenciais locais do MinIO usadas apenas em desenvolvimento
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Namespace do Object Storage
OBJECT_STORAGE_NAMESPACE=
