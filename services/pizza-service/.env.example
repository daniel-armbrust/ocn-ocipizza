APP_NAME=pizza-service
APP_ENV=development
DEBUG=true

# Providers suportados: nosql, sqlalchemy.
PERSISTENCE_PROVIDER=nosql

# Configuração do provider Oracle NoSQL.
NOSQL_TABLE_NAME=pizzas
NOSQL_ENDPOINT=http://localhost:18080
NOSQL_COMPARTMENT_ID=

# Configuração do provider SQLAlchemy.
# DATABASE_URL=mysql+pymysql://pizza_service:pizza_service@127.0.0.1:13306/pizzas

# Configuração dos access tokens emitidos pelo user-service.
JWT_ISSUER=user-service
JWT_AUDIENCE=oci-pizza
JWT_JWKS_URL=http://localhost:8002/.well-known/jwks.json

# Configuração do Object Storage.
OBJECTSTORAGE_ENDPOINT=http://localhost:9000
OBJECTSTORAGE_NAMESPACE=
OBJECTSTORAGE_BUCKET=pizza-images
OBJECTSTORAGE_ACCESS_KEY=minioadmin
OBJECTSTORAGE_SECRET_KEY=minioadmin

# Região utilizada pelo Oracle NoSQL fora de development.
OCI_REGION=sa-saopaulo-1

# OCID do Custom Log utilizado fora de development.
LOG_LEVEL=INFO
OCI_LOG_ID=
