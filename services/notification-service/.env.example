#
# notification-service/.env.example
#

APP_NAME=notification-service
APP_ENV=development
DEBUG=true

# URL pública do frontend utilizada na construção dos links enviados
# por e-mail.
SITE_URL=http://localhost:8010

# Diretório dos templates de e-mail. Quando omitido, utiliza
# app/templates/emails.
EMAIL_TEMPLATES_PATH=app/templates/emails

# Mensageria
# Providers suportados: rabbitmq, oci_queue.
MESSAGING_PROVIDER=rabbitmq
QUEUE_NAME=notifications-queue

# Intervalos do worker, em segundos.
NOTIFICATION_POLL_INTERVAL=5.0
NOTIFICATION_RETRY_INTERVAL=10.0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=oci_pizza
RABBITMQ_PASSWORD=oci_pizza

# OCI Queue
# Obrigatórias somente quando MESSAGING_PROVIDER=oci_queue.
OCI_QUEUE_ID=
OCI_QUEUE_MESSAGES_ENDPOINT=

# E-mail
# Providers suportados: smtp, oci.
EMAIL_PROVIDER=smtp

# SMTP local com Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_EMAIL_SENDER=no-reply@ocipizza.local

# OCI Email Delivery
# Obrigatória somente quando EMAIL_PROVIDER=oci.
OCI_EMAIL_DELIVERY_COMPARTMENT_ID=
OCI_EMAIL_SENDER_NAME=OCI Pizza

# Configurações compartilhadas pelos providers OCI.
OCI_REGION=sa-saopaulo-1

# Logging
LOG_LEVEL=INFO
OCI_LOG_ID=
